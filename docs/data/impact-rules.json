  "_meta": {
    "name": "Impact analysis matching rules",
    "version": 1,
    "generated": "2026-10-16",
    "purpose": "Deterministic rules that map a RegWatch item to instruments in applicability.json, to obligations in obligations.json, to customer segments and to task templates. No model is involved. Every match records the exact terms that produced it.",
    "method": "Score = identifier citation (4) + name in title (3) or in summary (2) + keyword in title (1.5) or summary (1), each distinct term counted once, broad terms capped at 1 in total, + 1 when the item comes from a source tied to the instrument (for example AMLA), + 0.5 when RegWatch's own theme maps to the instrument's topic. Confidence: high at 4 or more, medium at 2 or more, low above 0. A theme alone never rises above low.",
    "disclaimer": "Keyword rules are approximate. A match is a prompt to read the source, not a legal conclusion. Keywords are plain defaults: edit this file to tune them for your firm.",
    "ai_hook": "Marked AI HOOK in impact.js: AI-assisted matching (slice A3 of VISION.md) will plug into docs/ai.js later. Nothing in this file or in impact.js calls a model."
  },
