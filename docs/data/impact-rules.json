  "taskTemplates": {
    "confirm": {
      "title": "Confirm whether this change applies to us and record the decision",
      "detail": "Read the primary source, check the scope and entity types, and write down the conclusion in the assessment. Rule-based matching is approximate.",
      "role": "Compliance officer",
      "daysBefore": 90,
      "fallbackDays": 14,
      "weight": 0
    },
    "consult": {
      "title": "Decide whether to respond to the consultation, and by when",
      "detail": "Check the closing date at the source. If responding, assign a drafter and agree the position with senior management.",
      "role": "Compliance officer",
      "daysBefore": 14,
      "fallbackDays": 14,
      "weight": 0
    },
    "gap": {
      "title": "Design or map a control for {obligation}",
      "detail": "No control is mapped to this obligation in the register. Define the control, its owner, frequency and evidence, then map it in the Compliance workspace.",
      "role": "Control owner",
      "daysBefore": 60,
      "fallbackDays": 45,
      "weight": 0
    },
    "control": {
      "title": "Review control {control} against this change",
      "detail": "Check whether the control design, frequency, evidence and owner still satisfy the changed requirement. Re-test if the design changes.",
      "role": "Control owner",
      "daysBefore": 45,
      "fallbackDays": 30,
      "weight": 1
    },
    "policy": {
      "title": "Review and update policy {policy}",
      "detail": "Check the policy text against the change, publish a new version if needed and re-run attestations.",
      "role": "Policy owner",
      "daysBefore": 45,
      "fallbackDays": 30,
      "weight": 1
    },
    "customers": {
      "title": "Check onboarding forms, customer communications and procedures for {segments}",
      "detail": "List the customer-facing documents and processes that touch these segments and decide what must change.",
      "role": "Business owner",
      "daysBefore": 40,
      "fallbackDays": 30,
      "weight": 1
    },
    "training": {
      "title": "Update staff training and awareness for the change",
      "detail": "Brief affected staff and update training material once the controls and policies are settled.",
      "role": "Compliance officer",
      "daysBefore": 21,
      "fallbackDays": 60,
      "weight": 2
    },
    "board": {
      "title": "Brief senior management or the board on this change",
      "detail": "Summarise what changed, who is affected, the gaps, the deadline and the plan. The impact memo can be used as the basis.",
      "role": "Compliance officer",
      "daysBefore": 30,
      "fallbackDays": 21,
      "weight": 0
    },
    "monitor": {
      "title": "Re-check this change for progress and decide whether action is now needed",
      "detail": "Set a review point. Check the source for the final text, the effective date and any implementing measures.",
      "role": "Compliance officer",
      "daysBefore": 60,
      "fallbackDays": 90,
      "weight": 0
    }
  },
