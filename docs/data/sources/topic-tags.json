{
 "_meta": {
  "purpose": "Topic tags for the source corpus (RegWatch engine v2). Deterministic rules: a tag applies when one of its patterns matches and none of its exclude patterns matches the same text. Patterns are Python regular expressions, matched case-insensitively at word boundaries the pattern states itself. Covers EN, FR and NL wording where Belgian sources use it.",
  "maintained_by": "hand-edited; tested by tests/test_topic_precision.py against tests/golden/topic_golden.json",
  "not_the_site_taxonomy": "docs/data/topics.json is the site-wide topic list owned by another stream; this file is only the tagger's rule set. Map ids there when that file lands."
 },
