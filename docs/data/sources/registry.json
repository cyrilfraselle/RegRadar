      "url_patterns": ["https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:*"],
      "params": {"query": "oj_recent", "lookback_days": 21, "limit": 600},
      "polling": "daily", "scope": "topics", "max_docs": 4,
