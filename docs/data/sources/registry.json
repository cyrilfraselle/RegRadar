      "url": "https://publications.europa.eu/webapi/rdf/sparql",
      "url_patterns": ["https://eur-lex.europa.eu/legal-content/EN/TXT/?uri=CELEX:*", "http://publications.europa.eu/resource/celex/*"],
      "params": {"query": "related", "lookback_days": 400, "limit": 300,
                 "base_celex": ["32024R1624", "32024R1620", "32024L1640", "32023R1113", "32023R1114", "32015L0849", "32015L2366", "32009L0110", "32022R2554", "32015R0847"]},
      "polling": "daily", "scope": "all", "max_docs": 8,
      "notes": "Official CELLAR SPARQL endpoint (publications.europa.eu robots.txt: Allow /). Replaces the EUR-Lex RSS feeds: eur-lex.europa.eu/robots.txt disallows all agents. Includes corrigenda (CELEX ...R(nn)). Bases: AMLR, AMLAR, AMLD6, TFR, MiCA, AMLD4, PSD2, EMD2, DORA, old TFR."
    },
    {
